DYNAMIC_FEATURE_NAMES = [
    "GSL", "GS_temp", "GS_SM", "GS_SSRD", "GS_RH", "GS_SPEI",
    "NGS_temp", "NGS_SM", "NGS_SSRD", "NGS_RH", "NGS_SPEI",
]
STATIC_FEATURE_NAMES = ["Soil_clay", "Soil_soc", "IGBP"]
ALL_FEATURE_NAMES = DYNAMIC_FEATURE_NAMES + STATIC_FEATURE_NAMES
IGBP_CLASSES = list(range(1, 11))
CLIMATE_VARIABLES = {
    "GS_temp": "GS_TEMP_C", "GS_SM": "GS_SM_0_100cm_m3m3",
    "GS_SSRD": "GS_SSRD_Wm2", "GS_RH": "GS_RH_percent",
    "NGS_temp": "NGS_TEMP_C", "NGS_SM": "NGS_SM_0_100cm_m3m3",
    "NGS_SSRD": "NGS_SSRD_Wm2", "NGS_RH": "NGS_RH_percent",
}
SEARCH_SPACE = {
    "n_estimators": {"type": "int", "low": 100, "high": 1000},
    "max_depth": {"type": "int", "low": 3, "high": 12},
    "learning_rate": {"type": "float", "low": 0.01, "high": 0.2},
    "subsample": {"type": "float", "low": 0.6, "high": 1.0},
    "colsample_bytree": {"type": "float", "low": 0.6, "high": 1.0},
    "gamma": {"type": "float", "low": 1e-6, "high": 1.0, "log": True},
}
TEMPORAL_YEARS = {"train": (2001, 2014), "validation": (2016, 2018), "test": (2020, 2024)}
SUBSETS = ("train", "validation", "test")


@dataclass
class Samples:
    X: pd.DataFrame
    y: np.ndarray
    coordinates: pd.DataFrame
    metadata: dict[str, Any]


@dataclass
class Split:
    scheme: str
    assignment: np.ndarray
    details: pd.DataFrame
    metadata: dict[str, Any]

    def indices(self, subset):
        return np.flatnonzero(self.assignment == subset)


def write_json(path, values):
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    Path(path).write_text(json.dumps(values, ensure_ascii=False, indent=2, allow_nan=False), encoding="utf-8")


